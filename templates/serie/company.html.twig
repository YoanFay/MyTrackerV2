{% extends 'base.html.twig' %}

{% block title %}Série{% endblock %}

{% block body %}

    <div class="w-75">

        <h1>{{ company.name }}</h1>

        {% if studios %}
            <h2>
                Studios {# <a class="d-inline" href="{{ path('game_add') }}"><i class="material-icons">add_circle</i></a> #}</h2>
            <div class="col-12 d-flex flex-row flex-wrap justify-content-around">
                {% for studio in studios %}
                    <div class="card col-5 col-lg-2 mb-3 me-lg-1">
                        <div class="card-header p-0">
                            <a href="{{ path('serie_details', {'id': studio.id}) }}">
                                <img class="w-100" src="/image/serie/poster/{{ studio.tvdbId }}.jpeg">
                            </a>
                        </div>
                        <div class="card-body">
                            <p>
                                {{ studio.name }}
                            </p>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        {% if producers %}
            <h2>
                Producteurs {# <a class="d-inline" href="{{ path('game_add') }}"><i class="material-icons">add_circle</i></a> #}</h2>
            <div class="col-12 d-flex flex-row flex-wrap justify-content-around">
                {% for producer in producers %}
                    <div class="card col-5 col-lg-2 mb-3 me-lg-1">
                        <div class="card-header p-0">
                            <a href="{{ path('serie_details', {'id': producer.id}) }}">
                                <img class="w-100" src="/image/serie/poster/{{ producer.tvdbId }}.jpeg">
                            </a>
                        </div>
                        <div class="card-body">
                            <p>
                                {{ producer.name }}
                            </p>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        {% if networks %}
            <h2>
                Networks {# <a class="d-inline" href="{{ path('game_add') }}"><i class="material-icons">add_circle</i></a> #}</h2>
            <div class="col-12 d-flex flex-row flex-wrap justify-content-around">
                {% for network in networks %}
                    <div class="card col-5 col-lg-2 mb-3 me-lg-1">
                        <div class="card-header p-0">
                            <a href="{{ path('serie_details', {'id': network.id}) }}">
                                <img class="w-100" src="/image/serie/poster/{{ network.tvdbId }}.jpeg">
                            </a>
                        </div>
                        <div class="card-body">
                            <p>
                                {{ network.name }}
                            </p>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
