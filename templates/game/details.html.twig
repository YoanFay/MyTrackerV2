{% extends 'base.html.twig' %}

{% block title %}{{ game.name }}{% endblock %}

{% block body %}
    <div
        class="w-100 bg-game"{% if background %} style="background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('/image/game/background/{{ game.igdbId }}.jpeg')" {% endif %}>
        <div class="w-100 p-3 d-flex flex-column-reverse flex-lg-row justify-content-between">
            <div>
                <h1>
                    {{ game.name }}
                </h1>
                <div class="p-4 card max-content">
                    <h2>Date de sortie</h2>
                    <ul>
                        {% for release in game.gameReleases|sort((a, b) => a.releaseDate <=> b.releaseDate) %}
                            <li>{{ release.gamePlatform.name }} : {{ release.releaseDate|dateFNoDay }}
                                ({{ release.status.name }})
                            </li>
                        {% endfor %}
                    </ul>
                </div>
                <div class="mt-3 p-4 card max-content">
                    <h3>Information</h3>
                    <ul class="d-flex flex-row flex-wrap">
                        {% if game.gameCollections|length > 0 %}
                            <li class="me-4">
                                Collection :
                                <ul>
                                    {% for collection in game.gameCollections %}
                                        <li>{{ collection.name }}</li>
                                    {% endfor %}
                                </ul>
                            </li>
                        {% endif %}
                        <li class="me-4">
                            Game Mode :
                            <ul>
                                {% for gameMode in game.gameModes %}
                                    <li>
                                        {{ gameMode.nameFra ?? gameMode.nameEng }}
                                    </li>
                                {% endfor %}
                            </ul>
                        </li>
                        <li class="me-4">
                            Perspective :
                            <ul>
                                {% for playerPerspective in game.playerPerspectives %}
                                    <li>
                                        {{ playerPerspective.nameFra ?? playerPerspective.nameEng }}
                                    </li>
                                {% endfor %}
                            </ul>
                        </li>
                    </ul>
                    <hr>
                    <ul class="d-flex flex-row flex-wrap">
                        <li class="me-4">
                            Genres :
                            <ul>
                                {% for genre in game.igdbGenres %}
                                    <li>
                                        {{ genre.nameFra ?? genre.nameEng }}
                                    </li>
                                {% endfor %}
                            </ul>
                        </li>
                        <li class="me-4">
                            Thèmes :
                            <ul>
                                {% for theme in game.igdbThemes %}
                                    <li>
                                        {{ theme.nameFra ?? theme.nameEng }}
                                    </li>
                                {% endfor %}
                            </ul>
                        </li>
                    </ul>
                    <hr>
                    <ul class="d-flex flex-row flex-wrap">
                        {% for companyType in companies|filter(companyType => companyType.list != []) %}
                            <li class="me-4">
                                {{ companyType.frenchName }} :
                                <ul>
                                    {% for company in companyType.list %}
                                        <li>{{ company.name }}</li>
                                    {% endfor %}
                                </ul>
                            </li>
                        {% endfor %}
                    </ul>
                </div>

            </div>
            <div class="d-flex justify-content-end ms-2">
                <img
                    class="cover border border-secondary border-2"
                    src="/image/game/cover/{{ game.igdbId }}.jpeg"
                >
            </div>
        </div>

        <div class="w-100 p-4">
            <a class="btn btn-success" href="{{ path('game_new', {'id': game.id}) }}">Nouvelle partie</a>
            <a class="btn btn-primary" href="{{ path('game') }}">Retour</a>
        </div>

        {% if gameTrackers|length > 0 %}
            <div class="w-100 p-3 d-flex flex-column align-items-start col-12">
                <h2>Partie</h2>
                <div class="d-flex flex-column ms-lg-5 col-lg-7 col-md-6 col-12 max-content">
                    {% for tracker in gameTrackers %}
                        <div class="card border border-secondary rounded-3 d-flex flex-column p-2 my-2 w-100">
                            <p class="my-2">
                                {{ tracker.gamePlatform.name }}
                            </p>
                            <div class="d-flex flex-column justify-content-center max-content">
                                <hr class="my-1">
                                <ul class="my-1">
                                    <li>
                                        Commencé le {{ tracker.startDate|dateFNoDay }}
                                    </li>
                                    {% if tracker.endDate %}
                                        <li>
                                            Terminé le {{ tracker.endDate|dateFNoDay }} ({{tracker.endTime|MToHM}})
                                        </li>
                                        {% if tracker.completeDate %}
                                            <li>
                                                Terminé à 100% le {{ tracker.completeDate|dateFNoDay }} ({{tracker.completeTime|MToHM}})
                                            </li>
                                        {% elseif tracker.isNoComplete == false %}
                                            <a class="btn btn-success mt-3" href="{{path('game_complete', {'id': tracker.id})}}">
                                                Terminer à 100%
                                            </a>
                                        {% endif %}
                                    {% else %}
                                        <a class="btn btn-success mt-3" href="{{path('game_end', {'id': tracker.id})}}">
                                            Terminer
                                        </a>
                                    {% endif %}
                                </ul>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}
