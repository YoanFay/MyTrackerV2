{% extends 'base.html.twig' %}

{% block title %}Historique{% endblock %}

{% block body %}

{{ form_start(form, {'attr': {'style': 'width: 30%; max-width: 800px;'}}) }}

<div id="entries-list" data-prototype="{{ form_widget(form.entries.vars.prototype)|e('html_attr') }}" data-index="{{ form.entries|length }}">
    {% for entry in form.entries %}
        <div class="entry-item">
            {{ form_row(entry.title) }}
            {{ form_row(entry.watchedAt) }}
            <button type="button" class="remove-entry btn btn-danger">Supprimer</button>
        </div>
    {% endfor %}
</div>

    <div class="d-flex flex-row">

        <button type="button" id="add-entry" class="btn btn-primary me-3">+ Ajouter une entrée</button>

        {{ form_row(form.submit) }}

    </div>
{{ form_end(form) }}

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const entriesList = document.getElementById('entries-list');
        const addButton = document.getElementById('add-entry');

        addButton.addEventListener('click', function () {
            let index = entriesList.dataset.index;
            let prototype = entriesList.dataset.prototype.replace(/__name__/g, index);

            const div = document.createElement('div');
            div.classList.add('entry-item');
            div.innerHTML = prototype + '<button type="button" class="remove-entry btn btn-danger my-3">Supprimer</button>';

            entriesList.appendChild(div);
            entriesList.dataset.index = parseInt(index) + 1;
        });

        entriesList.addEventListener('click', function (e) {
            if (e.target.classList.contains('remove-entry')) {
                e.target.closest('.entry-item').remove();
            }
        });
    });
</script>

{% endblock %}
