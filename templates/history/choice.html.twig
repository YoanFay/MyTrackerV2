{% extends 'base.html.twig' %}

{% block title %}Historique{% endblock %}

{% block body %}

    <div class="d-flex flex-row mb-3">
        <a class="card-anime d-flex align-items-center justify-content-center me-3"
           href="{{ path('history_add', {'type': 'anime'}) }}">Anime</a>

        <a class="card-series d-flex align-items-center justify-content-center"
           href="{{ path('history_add', {'type': 'series'}) }}">Série</a>
    </div>

    <div class="d-flex flex-row">
        <a class="card-replay d-flex align-items-center justify-content-center me-3"
           href="{{ path('history_add', {'type': 'replay'}) }}">Replay</a>
        <a class="card-movie d-flex align-items-center justify-content-center"
           href="{{ path('history_add', {'type': 'movie'}) }}">Film</a>
    </div>

{% endblock %}
