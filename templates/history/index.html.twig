{% extends 'base.html.twig' %}

{% block title %}Historique{% endblock %}

{% block body %}
    <div class="w-75">

        <div class="col-12 d-flex flex-column flex-lg-row justify-content-lg-around">
            <div class="w-100">
                <h2 class="my-2 title-date"><a class="hide-link" href="{{ path("history_menu", {"year": "all"}) }}">Information
                        global</a></h2>
                <div>
                    <p class="m-0 px-1 badge badge-total">{{ showTime.total|MsToHM }}
                        de visionnage total</p>
                    {% if showTime.anime != 0 %}
                        <a href="{{path("history_type", {"type": "anime", "year": "all"})}}" class="m-0 px-1 badge badge-anime">{{ showTime.anime|MsToHM }}
                            d'animes</a>
                    {% endif %}
                    {% if showTime.series != 0 %}
                        <a href="{{path("history_type", {"type": "series", "year": "all"})}}" class="m-0 px-1 badge badge-series">{{ showTime.series|MsToHM }}
                            de séries</a>
                    {% endif %}
                    {% if showTime.replay != 0 %}
                        <a href="{{path("history_type", {"type": "replay", "year": "all"})}}" class="m-0 px-1 badge badge-replay">{{ showTime.replay|MsToHM }}
                            de replay</a>
                    {% endif %}
                    {% if showTime.movie != 0 %}
                        <a href="{{path("history_type", {"type": "movie", "year": "all"})}}" class="m-0 px-1 badge badge-movie">{{ showTime.movie|MsToHM }}
                            de films</a>
                    {% endif %}
                </div>
            </div>
        </div>


        <div class="ps-3 my-3 d-flex flex-column align-items-end">

            {% for yearKey, year in showTime.year|reverse(true) %}

                <div class="w-100 ps-3 my-2">
                    <h3><a class="hide-link" href="{{ path("history", {'year': yearKey}) }}">{{ yearKey }}</a></h3>
                    <div>
                        <p class="m-0 px-1 badge badge-total">{{ year.total|MsToHM }}
                            de visionnage total</p>
                        {% if year.anime != 0 %}
                            <a href="{{ path("history_type", {'type': 'anime', 'year': yearKey}) }}" class="m-0 px-1 badge badge-anime">{{ year.anime|MsToHM }}
                                d'animes</a>
                        {% endif %}
                        {% if year.series != 0 %}
                            <a href="{{ path("history_type", {'type': 'series', 'year': yearKey}) }}" class="m-0 px-1 badge badge-series">{{ year.series|MsToHM }}
                                de séries</a>
                        {% endif %}
                        {% if year.replay != 0 %}
                            <a href="{{ path("history_type", {'type': 'replay', 'year': yearKey}) }}" class="m-0 px-1 badge badge-replay">{{ year.replay|MsToHM }}
                                de replay</a>
                        {% endif %}
                        {% if year.movie != 0 %}
                            <a href="{{ path("history_type", {'type': 'movie', 'year': yearKey}) }}" class="m-0 px-1 badge badge-movie">{{ year.movie|MsToHM }}
                                de films</a>
                        {% endif %}
                    </div>

                    {% for monthKey, month in year.month %}

                        <div class="w-100 ps-3 my-1">
                            <h4><a class="hide-link"
                                   href="{{ path("history", {'year': yearKey, 'month': monthKey}) }}">{{ monthKey|dateM }}</a>
                            </h4>
                            <div>
                                <p class="m-0 px-1 badge badge-total">{{ month.total|MsToHM }}
                                    de visionnage total</p>
                                {% if month.anime != 0 %}
                                    <a href="{{ path("history_type", {'type': 'anime', 'year': yearKey, 'month': monthKey}) }}" class="m-0 px-1 badge badge-anime">{{ month.anime|MsToHM }}
                                        d'animes</a>
                                {% endif %}
                                {% if month.series != 0 %}
                                    <a href="{{ path("history_type", {'type': 'series', 'year': yearKey, 'month': monthKey}) }}" class="m-0 px-1 badge badge-series">{{ month.series|MsToHM }}
                                        de séries</a>
                                {% endif %}
                                {% if month.replay != 0 %}
                                    <a href="{{ path("history_type", {'type': 'replay', 'year': yearKey, 'month': monthKey}) }}" class="m-0 px-1 badge badge-replay">{{ month.replay|MsToHM }}
                                        de replay</a>
                                {% endif %}
                                {% if month.movie != 0 %}
                                    <a href="{{ path("history_type", {'type': 'movie', 'year': yearKey, 'month': monthKey}) }}" class="m-0 px-1 badge badge-movie">{{ month.movie|MsToHM }}
                                        de films</a>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}

                </div>
            {% endfor %}

        </div>

    </div>
{% endblock %}
